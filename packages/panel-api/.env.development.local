NODE_ENV = "development"
PORT = 5000

# MongoDB
MONGO_URI="mongodb://admin:secretpassword@localhost:27017/skynode?authSource=admin"
API_VERSION="v1"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-in-production-abc123"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-xyz789"

# Kafka
KAFKA_BROKER="localhost:9092"
KAFKA_ENABLED="true"

# Mail (SMTP)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@skynode.local"